      "id": "checkpoint",
      "title": "Checkpoint",
      "headline": "Bus arrivals, built around confirmed checkpoints",
      "summary": "A checkpoint-based bus arrival tracker for Philippine provincial routes.",
      "role": "Full-stack web application",
      "description": "Checkpoint estimates provincial bus arrivals from conductor-confirmed checkpoints and baseline travel times, rather than continuous bus GPS tracking. Guests can find stops and inbound buses without an account, while conductors and operations staff use role-based tools.",
      "bullets": [
        "Public station search and arrivals board with map-based stop discovery",
        "Conductor checkpoint updates with offline queuing and synchronization",
        "Role-based staff access and administration for routes, fleet, schedules and trips"
      ],
      "categories": [
        "Web Application",
        "Transport & Operations"
      ],
      "tags": [
        "React",
        "Node.js",
        "Express.js",
        "MongoDB",
